// Design tokens for the "Flow" design direction. Views never hard-code colours or sizes;
// they read them from here, so themes (and dynamic album colours) apply everywhere.

// One theme's neutral colours. Rust picks the theme (lychee::themes) and sets `Theme.colors`.
export struct ThemeColors {
    dark: bool,
    bg: color,
    side: color,
    surface: color,
    surface-2: color,
    hover: color,
    pressed: color,
    border: color,
    border-2: color,
    text: color,
    text-2: color,
    text-3: color,
}

export global Theme {
    in-out property <ThemeColors> colors: {
        dark: true,
        bg: #0B0B0D,
        side: #0E0E11,
        surface: #131317,
        surface-2: #19191E,
        hover: #1E1E24,
        pressed: #26262D,
        border: #222228,
        border-2: #2C2C34,
        text: #F4F4F5,
        text-2: #A1A1AA,
        text-3: #6B6B76,
    };
    out property <bool> dark: colors.dark;
    // Accent colour: the theme's own, or taken from the current album's artwork when dynamic colour is on.
    in-out property <color> accent: #FF6B7D;
    // Dark tint used behind album headers.
    in-out property <color> tint: #1B2A44;

    out property <color> bg: colors.bg;
    out property <color> side: colors.side;
    out property <color> surface: colors.surface;
    out property <color> surface-2: colors.surface-2;
    out property <color> hover: colors.hover;
    out property <color> pressed: colors.pressed;
    out property <color> border: colors.border;
    out property <color> border-2: colors.border-2;
    out property <color> text: colors.text;
    out property <color> text-2: colors.text-2;
    out property <color> text-3: colors.text-3;
    // Text on accent fills: dark or white, whichever reads better on the accent.
    in-out property <color> on-accent: #16100F;
    out property <color> danger: #F2555A;
    out property <color> success: #3CCB7F;
    out property <color> warning: #F5A524;
    out property <color> scrim: dark ? #000000a0 : #14141e40;
    out property <color> shadow: dark ? #00000090 : #0000002a;

    out property <string> font: "Geist";
    out property <string> mono: "Geist Mono";

    out property <length> radius-s: 7px;
    out property <length> radius-m: 10px;
    out property <length> radius-l: 14px;

    out property <duration> fast: 120ms;
    out property <duration> medium: 220ms;
}
