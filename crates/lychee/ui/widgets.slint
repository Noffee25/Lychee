import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

// Small dark bubble used for tooltips.
export component Bubble inherits Rectangle {
    in property <string> text;
    background: Theme.dark ? #F4F4F5 : #18181B;
    border-radius: 6px;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000040;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: Theme.dark ? #0B0B0D : #F4F4F5;
            font-size: 12px;
            font-weight: 500;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> icon-size: 18px;
    in property <length> size: 32px;
    in property <string> tooltip;
    in property <color> tint: !root.enabled ? Theme.text-3 : root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-2;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: Theme.radius-s;
    background: ta.pressed ? Theme.pressed : ta.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    Image {
        source: root.icon;
        colorize: root.tint;
        width: root.icon-size;
        height: root.icon-size;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip {
        Bubble { text: root.tooltip; }
    }
}

// Album art with rounded corners and a generated placeholder when there is no image.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <color> seed: #3a3a46;
    in property <length> radius: Theme.radius-m;
    in property <bool> round;
    border-radius: root.round ? self.width / 2 : root.radius;
    clip: true;
    background: @linear-gradient(135deg, root.seed.brighter(0.25) 0%, root.seed.darker(0.45) 100%);
    if !root.has-image: Image {
        source: Icons.music;
        colorize: #ffffff66;
        width: root.width * 0.34;
        height: root.width * 0.34;
    }
    if root.has-image: Image {
        source: root.source;
        width: root.width;
        height: root.height;
        image-fit: cover;
    }
}

// Three static bars marking the playing row (static on purpose: no constant redraws).
export component PlayingBars inherits Rectangle {
    in property <color> bar-color: Theme.accent;
    width: 14px;
    height: 14px;
    Rectangle { x: 0px; y: 6px; width: 3px; height: 8px; border-radius: 1px; background: root.bar-color; }
    Rectangle { x: 5px; y: 0px; width: 3px; height: 14px; border-radius: 1px; background: root.bar-color; }
    Rectangle { x: 10px; y: 4px; width: 3px; height: 10px; border-radius: 1px; background: root.bar-color; }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <bool> highlight;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.highlight ? Theme.accent.with-alpha(0.55) : Theme.border-2;
    background: Theme.surface.with-alpha(0.55);
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 11px;
            color: root.highlight ? Theme.accent : Theme.text-2;
            vertical-alignment: center;
        }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <length> pill-height: 40px;
    callback clicked;
    height: root.pill-height;
    border-radius: root.pill-height / 2;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary ? (ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (ta.has-hover ? Theme.hover : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? Theme.danger.with-alpha(0.6) : Theme.border-2;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: root.pill-height * 0.42;
        padding-right: root.pill-height * 0.42;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Image {
            source: root.icon;
            colorize: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
            font-weight: 600;
            font-size: root.pill-height > 34px ? 13.5px : 12.5px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A horizontal slider for progress and volume. `changed` fires on click/release, `preview` while dragging.
export component SeekBar inherits Rectangle {
    in property <float> value;
    in property <color> fill-color: Theme.text;
    in property <bool> knob-always;
    in property <int> duration-ms;
    callback changed(float);
    callback preview(float);
    property <float> drag-value;
    property <bool> dragging;
    property <float> shown: root.dragging ? root.drag-value : Math.max(0, Math.min(1, root.value));
    property <float> hover-fraction: Math.max(0, Math.min(1, ta.mouse-x / Math.max(1px, root.width)));
    property <int> hover-ms: Math.round(root.hover-fraction * root.duration-ms);
    property <int> hover-s: Math.floor(root.hover-ms / 1000);
    height: 16px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: 100%;
        border-radius: 2px;
        background: Theme.border-2;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.shown;
        border-radius: 2px;
        background: ta.has-hover || root.dragging ? Theme.accent : root.fill-color;
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        x: parent.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
        background: Theme.text;
        opacity: ta.has-hover || root.dragging || root.knob-always ? 1 : 0;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000060;
        animate opacity { duration: Theme.fast; }
    }
    if ta.has-hover && root.duration-ms > 0: Bubble {
        x: Math.max(0px, Math.min(root.width - self.width, ta.mouse-x - self.width / 2));
        y: -30px;
        text: Math.floor(root.hover-s / 60) + ":" + (Math.mod(root.hover-s, 60) < 10 ? "0" : "") + Math.mod(root.hover-s, 60);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.dragging = true;
                root.drag-value = Math.max(0, Math.min(1, self.mouse-x / self.width));
            } else if (e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.changed(root.drag-value);
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-value = Math.max(0, Math.min(1, self.mouse-x / self.width));
                root.preview(root.drag-value);
            }
        }
        scroll-event(e) => {
            if (e.delta-y != 0) {
                root.changed(Math.max(0, Math.min(1, root.value + (e.delta-y > 0 ? 0.05 : -0.05))));
                return accept;
            }
            reject
        }
    }
}

export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <image> icon: Icons.search;
    in property <bool> has-icon: true;
    in property <bool> password;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-2;
    background: Theme.surface;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.has-icon: Image {
            source: root.icon;
            colorize: Theme.text-3;
            width: 15px;
            height: 15px;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: 13.5px;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.35);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                x: 0px;
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.text-3;
                font-size: 13.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.border-2;
    animate background { duration: Theme.fast; }
    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        x: root.checked ? parent.width - 20px : 2px;
        y: 2px;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.medium; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 32px;
    border-radius: 9px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: 7px;
            background: i == root.selected ? Theme.bg : seg-ta.has-hover ? Theme.hover : transparent;
            drop-shadow-blur: i == root.selected ? 3px : 0px;
            drop-shadow-color: #00000030;
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: option;
                    color: i == root.selected ? Theme.text : Theme.text-2;
                    font-weight: 500;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> count;
    in property <bool> active;
    in property <bool> use-cover;
    in property <bool> liked-tile;
    in property <image> cover;
    in property <bool> has-cover;
    in property <color> seed: #444;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: root.active ? Theme.surface-2 : nav-ta.has-hover ? Theme.hover : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.liked-tile: Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            background: @linear-gradient(135deg, Theme.accent 0%, #8B5CF6 100%);
            Image { source: Icons.heart-fill; colorize: #ffffff; width: 10px; height: 10px; }
        }
        if root.use-cover && !root.liked-tile: Cover {
            width: 18px;
            height: 18px;
            radius: 5px;
            source: root.cover;
            has-image: root.has-cover;
            seed: root.seed;
        }
        if !root.use-cover && !root.liked-tile: Image {
            source: root.icon;
            colorize: root.active ? Theme.text : Theme.text-2;
            width: 17px;
            height: 17px;
        }
        Text {
            text: root.label;
            color: root.active || nav-ta.has-hover ? Theme.text : Theme.text-2;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.count != "": Text {
            text: root.count;
            font-family: Theme.mono;
            font-size: 11.5px;
            color: Theme.text-3;
            vertical-alignment: center;
        }
    }
    nav-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}
