import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

// Small dark bubble used for tooltips.
export component Bubble inherits Rectangle {
    in property <string> text;
    background: Theme.dark ? #F4F4F5 : #18181B;
    border-radius: 6px;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000040;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: Theme.dark ? #0B0B0D : #F4F4F5;
            font-size: 12px;
            font-weight: 500;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> icon-size: 18px;
    in property <length> size: 32px;
    in property <string> tooltip;
    in property <color> tint: !root.enabled ? Theme.text-3 : root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-2;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: Theme.radius-s;
    background: ta.pressed ? Theme.pressed : ta.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    Image {
        source: root.icon;
        colorize: root.tint;
        width: root.icon-size;
        height: root.icon-size;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip {
        Bubble { text: root.tooltip; }
    }
}

// Album art with rounded corners and a generated placeholder when there is no image.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <color> seed: #3a3a46;
    in property <length> radius: Theme.radius-m;
    in property <bool> round;
    border-radius: root.round ? self.width / 2 : root.radius;
    clip: true;
    background: @linear-gradient(135deg, root.seed.brighter(0.25) 0%, root.seed.darker(0.45) 100%);
    if !root.has-image: Image {
        source: Icons.music;
        colorize: #ffffff66;
        width: root.width * 0.34;
        height: root.width * 0.34;
    }
    if root.has-image: Image {
        source: root.source;
        width: root.width;
        height: root.height;
        image-fit: cover;
    }
}

// Three static bars marking the playing row (static on purpose: no constant redraws).
export component PlayingBars inherits Rectangle {
    in property <color> bar-color: Theme.accent;
    width: 14px;
    height: 14px;
    Rectangle { x: 0px; y: 6px; width: 3px; height: 8px; border-radius: 1px; background: root.bar-color; }
    Rectangle { x: 5px; y: 0px; width: 3px; height: 14px; border-radius: 1px; background: root.bar-color; }
    Rectangle { x: 10px; y: 4px; width: 3px; height: 10px; border-radius: 1px; background: root.bar-color; }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <bool> highlight;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.highlight ? Theme.accent.with-alpha(0.55) : Theme.border-2;
    background: Theme.surface.with-alpha(0.55);
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 11px;
            color: root.highlight ? Theme.accent : Theme.text-2;
            vertical-alignment: center;
        }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <length> pill-height: 40px;
    callback clicked;
    // Disabled looks are colours, not `opacity`: a faded container is drawn through an offscreen
    // layer, which makes its text blurry.
    property <bool> lit: root.primary && root.enabled;
    property <color> ink: !root.enabled ? Theme.text-3 : root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
    height: root.pill-height;
    border-radius: root.pill-height / 2;
    background: root.lit ? (ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : root.primary ? Theme.surface-2
        : (ta.has-hover && root.enabled ? Theme.hover : transparent);
    border-width: root.lit ? 0px : 1px;
    border-color: root.danger && root.enabled ? Theme.danger.with-alpha(0.6) : !root.enabled ? Theme.border : Theme.border-2;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: root.pill-height * 0.42;
        padding-right: root.pill-height * 0.42;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Image {
            source: root.icon;
            colorize: root.ink;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-weight: 600;
            font-size: root.pill-height > 34px ? 13.5px : 12.5px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A horizontal slider for progress and volume. `changed` fires on click/release, `preview` while dragging.
// With a duration (the seek bar), `previewing` and `preview-text` say where the pointer is, for a
// time label next to the bar; nothing floats over the controls around it.
export component SeekBar inherits Rectangle {
    in property <float> value;
    in property <color> fill-color: Theme.text;
    in property <bool> knob-always;
    in property <int> duration-ms;
    callback changed(float);
    callback preview(float);
    property <float> drag-value;
    property <bool> dragging;
    property <float> shown: root.dragging ? root.drag-value : Math.max(0, Math.min(1, root.value));
    // Set from pointer events rather than bound to the bar's width: a label sized by
    // `preview-text` sits in the same layout, and a binding would make a loop.
    property <float> hover-fraction;
    out property <bool> previewing: root.duration-ms > 0 && (ta.has-hover || root.dragging);
    property <int> preview-s: Math.floor((root.dragging ? root.drag-value : root.hover-fraction) * root.duration-ms / 1000);
    out property <string> preview-text: root.clock(root.preview-s);
    pure function two(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }
    pure function clock(s: int) -> string {
        return s >= 3600
            ? Math.floor(s / 3600) + ":" + root.two(Math.mod(Math.floor(s / 60), 60)) + ":" + root.two(Math.mod(s, 60))
            : Math.floor(s / 60) + ":" + root.two(Math.mod(s, 60));
    }
    height: 16px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: 100%;
        border-radius: 2px;
        background: Theme.border-2;
    }
    // Where a click would seek to.
    if root.previewing && !root.dragging: Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.hover-fraction;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.18);
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.shown;
        border-radius: 2px;
        background: ta.has-hover || root.dragging ? Theme.accent : root.fill-color;
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        x: parent.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
        background: Theme.text;
        opacity: ta.has-hover || root.dragging || root.knob-always ? 1 : 0;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000060;
        animate opacity { duration: Theme.fast; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move || e.kind == PointerEventKind.down) {
                root.hover-fraction = Math.max(0, Math.min(1, self.mouse-x / Math.max(1px, self.width)));
            }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.dragging = true;
                root.drag-value = Math.max(0, Math.min(1, self.mouse-x / self.width));
            } else if (e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.changed(root.drag-value);
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-value = Math.max(0, Math.min(1, self.mouse-x / self.width));
                root.preview(root.drag-value);
            }
        }
        scroll-event(e) => {
            if (e.delta-y != 0) {
                root.changed(Math.max(0, Math.min(1, root.value + (e.delta-y > 0 ? 0.05 : -0.05))));
                return accept;
            }
            reject
        }
    }
}

export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <image> icon: Icons.search;
    in property <bool> has-icon: true;
    in property <bool> password;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-2;
    background: Theme.surface;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.has-icon: Image {
            source: root.icon;
            colorize: Theme.text-3;
            width: 15px;
            height: 15px;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: 13.5px;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.35);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                x: 0px;
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.text-3;
                font-size: 13.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.border-2;
    animate background { duration: Theme.fast; }
    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        x: root.checked ? parent.width - 20px : 2px;
        y: 2px;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.medium; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 32px;
    border-radius: 9px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: 7px;
            background: i == root.selected ? Theme.bg : seg-ta.has-hover ? Theme.hover : transparent;
            drop-shadow-blur: i == root.selected ? 3px : 0px;
            drop-shadow-color: #00000030;
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: option;
                    color: i == root.selected ? Theme.text : Theme.text-2;
                    font-weight: 500;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> count;
    in property <bool> active;
    in property <bool> use-cover;
    in property <bool> liked-tile;
    in property <image> cover;
    in property <bool> has-cover;
    in property <color> seed: #444;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: root.active ? Theme.surface-2 : nav-ta.has-hover ? Theme.hover : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.liked-tile: Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            background: @linear-gradient(135deg, Theme.accent 0%, #8B5CF6 100%);
            Image { source: Icons.heart-fill; colorize: #ffffff; width: 10px; height: 10px; }
        }
        if root.use-cover && !root.liked-tile: Cover {
            width: 18px;
            height: 18px;
            radius: 5px;
            source: root.cover;
            has-image: root.has-cover;
            seed: root.seed;
        }
        if !root.use-cover && !root.liked-tile: Image {
            source: root.icon;
            colorize: root.active ? Theme.text : Theme.text-2;
            width: 17px;
            height: 17px;
        }
        Text {
            text: root.label;
            color: root.active || nav-ta.has-hover ? Theme.text : Theme.text-2;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.count != "": Text {
            text: root.count;
            font-family: Theme.mono;
            font-size: 11.5px;
            color: Theme.text-3;
            vertical-alignment: center;
        }
    }
    nav-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Artist names separated by commas, each one a link: "Denzel Curry, Twelve'len, GoldLink".
// Names keep their full width and only the last one elides; if the earlier ones already don't
// fit, the row is clipped and fades into `fade-color` (the background behind it).
export component ArtistLinks inherits Rectangle {
    in property <[string]> names;
    in property <length> font-size: 12.5px;
    in property <brush> text-color: Theme.text-2;
    in property <brush> hover-color: Theme.text;
    in property <color> fade-color: Theme.side;
    callback clicked(string);
    clip: true;
    min-width: 0px;
    preferred-width: row.preferred-width;
    height: row.preferred-height;
    row := HorizontalLayout {
        alignment: start;
        for name[i] in root.names: HorizontalLayout {
            if i > 0: Text {
                text: ", ";
                font-size: root.font-size;
                color: root.text-color;
            }
            Text {
                min-width: i == root.names.length - 1 ? 0px : self.preferred-width;
                text: name;
                font-size: root.font-size;
                color: ta.has-hover ? root.hover-color : root.text-color;
                overflow: elide;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clicked(name); }
                }
            }
        }
    }
    if row.min-width > root.width: Rectangle {
        x: root.width - self.width;
        width: 32px;
        background: @linear-gradient(90deg, root.fade-color.transparentize(100%) 0%, root.fade-color 85%);
    }
}

// A small busy indicator in the accent colour (the std Spinner uses the Fluent blue).
export component BusyRing inherits Rectangle {
    in property <color> ink: Theme.accent;
    width: 24px;
    height: 24px;
    Rectangle {
        border-radius: self.width / 2;
        border-width: 2.5px;
        border-color: Theme.border-2;
    }
    Rectangle {
        transform-rotation: Math.mod(animation-tick() / 1ms, 900) / 900 * 360deg;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 12 1.25 A 10.75 10.75 0 0 1 22.75 12";
            stroke: root.ink;
            stroke-width: 2.5px;
        }
    }
}
