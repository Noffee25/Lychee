import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Player, Actions } from "state.slint";
import { Cover, IconButton } from "widgets.slint";

// The Flow "compact bar": an always-on-top mini player.
export component MiniWindow inherits Window {
    title: "Lychee";
    icon: @image-url("icons/logo.svg");
    no-frame: true;
    always-on-top: true;
    width: 400px;
    height: 88px;
    background: Theme.surface;
    default-font-family: "Geist";
    default-font-size: 13.5px;
    property <bool> hovered: drag-ta.has-hover;

    // Drag the background to move the window. The move starts only once the pointer has
    // travelled a few pixels, so a plain click never hands the pointer to the window manager.
    drag-ta := TouchArea {
        property <bool> dragging;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.dragging = false;
            }
        }
        moved => {
            if (!self.dragging && self.pressed
                && (Math.abs(self.mouse-x - self.pressed-x) > 3px || Math.abs(self.mouse-y - self.pressed-y) > 3px)) {
                self.dragging = true;
                Actions.start-window-drag();
            }
        }
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.border-2;
    }
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 12px;
        padding-right: 10px;
        padding-bottom: 3px;
        spacing: 12px;
        Cover {
            width: 60px;
            height: 60px;
            radius: 9px;
            source: Player.now.cover;
            has-image: Player.now.has-cover;
            seed: Player.now.seed;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: Player.now.has-track ? Player.now.title : "Nothing playing";
                font-weight: 600;
                font-size: 14px;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: Player.now.artist;
                font-size: 12.5px;
                color: Theme.text-2;
                overflow: elide;
            }
            Text {
                text: Player.now.has-track ? Player.now.format + " · " + Player.position-text + " / " + Player.duration-text : "";
                font-family: Theme.mono;
                font-size: 10.5px;
                color: Theme.text-3;
                overflow: elide;
            }
        }
        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: 2px;
            alignment: center;
            IconButton {
                icon: Icons.prev;
                icon-size: 17px;
                clicked => { Actions.previous(); }
            }
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.text;
                Image {
                    source: Player.playing ? Icons.pause : Icons.play;
                    colorize: Theme.bg;
                    width: 16px;
                    height: 16px;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Actions.toggle-play(); }
                }
            }
            IconButton {
                icon: Icons.next;
                icon-size: 17px;
                clicked => { Actions.next(); }
            }
        }
    }
    // Window buttons, shown on hover.
    HorizontalLayout {
        cross-axis-alignment: center;
        x: parent.width - self.preferred-width - 4px;
        y: 4px;
        height: 22px;
        spacing: 0px;
        opacity: root.hovered || expand.has-hover || close.has-hover ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        expand := IconButton {
            property <bool> has-hover: self.background != transparent;
            icon: Icons.expand;
            size: 22px;
            icon-size: 12px;
            // Back to the full window: the mini player closes, like the helper process does.
            clicked => { Actions.close-mini(); }
        }
        close := IconButton {
            property <bool> has-hover: self.background != transparent;
            icon: Icons.x;
            size: 22px;
            icon-size: 13px;
            clicked => { Actions.close-mini(); }
        }
    }
    // Progress along the bottom edge in the accent colour.
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: Theme.border-2;
        Rectangle {
            x: 0px;
            width: parent.width * Math.max(0, Math.min(1, Player.progress));
            background: Theme.accent;
        }
    }
}
