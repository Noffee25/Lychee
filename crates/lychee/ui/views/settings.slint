import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppState, Player, Actions, ThemeCard } from "../state.slint";
import { PillButton, IconButton, Toggle, Segmented, TextField, Divider } from "../widgets.slint";
import { Grid, PageHeader } from "albums.slint";
import { ScrollView, AboutSlint } from "std-widgets.slint";

// A card of settings. Sections that are one feature (the equalizer, volume levelling) have their
// switch beside the title.
export component Section inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> has-switch;
    in-out property <bool> on;
    callback switched(bool);
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: 16px;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 650;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            if root.has-switch: Toggle {
                checked <=> root.on;
                toggled(on) => { root.switched(on); }
            }
        }
        if root.description != "": Text {
            text: root.description;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        @children
    }
}

export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            font-weight: 500;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 12.5px;
            color: Theme.text-3;
            wrap: word-wrap;
        }
    }
    @children
}

component ShortcutRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    height: 28px;
    Text {
        text: root.action;
        color: Theme.text-2;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border-2;
        background: Theme.surface-2;
        height: 22px;
        width: key-text.preferred-width + 14px;
        key-text := Text {
            text: root.keys;
            font-family: Theme.mono;
            font-size: 11.5px;
            color: Theme.text;
        }
    }
}

// The title of a page inside Settings, "Settings › Audio": "Settings" leads back.
export component SubpageHeader inherits HorizontalLayout {
    in property <string> title;
    padding-left: Grid.side-padding;
    padding-right: Grid.side-padding;
    padding-top: 4px;
    padding-bottom: 18px;
    spacing: 8px;
    alignment: start;
    Text {
        text: "Settings";
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.6px;
        color: back-ta.has-hover ? Theme.text-2 : Theme.text-3;
        animate color { duration: Theme.fast; }
        back-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Actions.navigate("settings"); }
        }
    }
    VerticalLayout {
        alignment: center;
        Image {
            source: Icons.chev-r;
            colorize: Theme.text-3;
            width: 24px;
            height: 24px;
        }
    }
    Text {
        text: root.title;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.6px;
        color: Theme.text;
        overflow: elide;
    }
}

// A card on the Settings page that opens a page of its own (Audio): what's there, and how it's
// set up now.
component SettingsLink inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> summary;
    callback clicked;
    border-radius: 12px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-2 : Theme.border;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding: 20px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 650;
                color: Theme.text;
            }
            Text {
                text: root.description;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            if root.summary != "": Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: 12px;
                color: Theme.text-3;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.chev-r;
                colorize: ta.has-hover ? Theme.text : Theme.text-3;
                width: 20px;
                height: 20px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A theme's colours in small: its background with a line of text and an accent dot.
component ThemeSwatch inherits Rectangle {
    in property <ThemeCard> theme;
    width: 30px;
    height: 20px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.theme.colors.border-2;
    background: root.theme.colors.bg;
    Rectangle {
        x: 6px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: root.theme.accent;
    }
    Rectangle {
        x: 16px;
        width: 8px;
        height: 3px;
        border-radius: 1.5px;
        background: root.theme.colors.text-2;
    }
}

// Picks the dark or the light theme: the current one in a field, the others drop down from it.
component ThemeSelect inherits Rectangle {
    in property <[ThemeCard]> themes;
    in property <ThemeCard> current;
    width: 250px;
    height: 38px;
    border-radius: 9px;
    border-width: 1px;
    border-color: select-ta.has-hover ? Theme.text-3 : Theme.border-2;
    background: Theme.surface-2;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        ThemeSwatch { theme: root.current; }
        Text {
            text: root.current.name;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Image {
            source: Icons.chev-d;
            colorize: Theme.text-2;
            width: 15px;
            height: 15px;
        }
    }
    select-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 6px;
        width: root.width;
        height: Math.min(340px, 16px + root.themes.length * 36px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-2;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            // Inset so the list clips itself rectangularly inside the rounded card.
            sv := ScrollView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-width: self.visible-width;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: sv.visible-width;
                    padding: 7px;
                    spacing: 2px;
                    for t in root.themes: Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: theme-ta.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 6px;
                            padding-right: 10px;
                            spacing: 10px;
                            ThemeSwatch { theme: t; }
                            Text {
                                text: t.name;
                                color: t.selected ? Theme.accent : Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if t.selected: Image {
                                source: Icons.check;
                                colorize: Theme.accent;
                                width: 15px;
                                height: 15px;
                            }
                        }
                        theme-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Actions.set-theme(t.id);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <bool> scrolled: sv.content-y < -8px;
    changed scrolled => { AppState.content-scrolled = root.scrolled; }
    init => { AppState.content-scrolled = false; }
    sv := ScrollView {
        content-width: self.visible-width;
        content-height: page.preferred-height;
        page := VerticalLayout {
            width: sv.visible-width;
            padding-top: 52px;
            padding-bottom: 40px;
            alignment: start;
            PageHeader {
                title: "Settings";
                subtitle: "Lychee " + AppState.version;
            }
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 24px;
                padding-right: 24px;
                alignment: start;
                VerticalLayout {
                    max-width: 780px;
                    horizontal-stretch: 1;
                    spacing: 18px;

                    Section {
                        title: "Library";
                        description: "Lychee indexes these folders and picks up changes when you rescan. It only changes your files when you save in the tag editor.";
                        for folder in AppState.folders: Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: Theme.surface-2;
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 12px;
                                padding-right: 4px;
                                spacing: 10px;
                                Image {
                                    source: Icons.folder;
                                    colorize: Theme.text-2;
                                    width: 16px;
                                    height: 16px;
                                }
                                Text {
                                    text: folder;
                                    font-family: Theme.mono;
                                    font-size: 12.5px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    icon: Icons.x;
                                    tooltip: "Remove folder";
                                    clicked => { Actions.remove-folder(folder); }
                                }
                            }
                        }
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            spacing: 10px;
                            alignment: start;
                            PillButton {
                                text: "Add folder…";
                                icon: Icons.folder-plus;
                                primary: AppState.folders.length == 0;
                                pill-height: 36px;
                                clicked => { Actions.add-folder(); }
                            }
                            PillButton {
                                text: AppState.scan.active ? "Scanning…" : "Rescan library";
                                icon: Icons.refresh;
                                enabled: !AppState.scan.active && AppState.folders.length > 0;
                                pill-height: 36px;
                                clicked => { Actions.rescan(); }
                            }
                        }
                        Text {
                            text: AppState.scan.active ? AppState.scan.text : AppState.library-summary;
                            font-family: Theme.mono;
                            font-size: 12px;
                            color: Theme.text-3;
                        }
                    }

                    SettingsLink {
                        title: "Audio";
                        description: "Output device, equalizer, volume levelling, crossfade and headphone crossfeed.";
                        summary: AppState.audio-summary;
                        clicked => { Actions.navigate("audio"); }
                    }

                    Section {
                        title: "Last.fm";
                        description: "Scrobble what you listen to and keep your Last.fm profile up to date. Scrobbles are queued while you're offline.";
                        if Player.lastfm.state != "disconnected" && Player.lastfm.state != "connecting": SettingRow {
                            label: Player.lastfm.state == "error" ? "Connection needs attention" : "Connected as " + Player.lastfm.username;
                            hint: Player.lastfm.state == "error" ? Player.lastfm.message
                                : Player.lastfm.state == "offline" ? "Offline: \{Player.lastfm.pending} scrobble(s) queued, retrying automatically."
                                : Player.lastfm.scrobbled > 0 ? "\{Player.lastfm.scrobbled} scrobbled this session" + (Player.lastfm.last != "" ? ". Last: " + Player.lastfm.last : "")
                                : "Scrobbling is on.";
                            if Player.lastfm.state == "error": PillButton {
                                text: "Reconnect";
                                icon: Icons.link;
                                primary: true;
                                pill-height: 34px;
                                clicked => { Actions.lastfm-connect(); }
                            }
                            PillButton {
                                text: "Profile";
                                icon: Icons.external;
                                pill-height: 34px;
                                clicked => { Actions.lastfm-open-profile(); }
                            }
                            PillButton {
                                text: "Disconnect";
                                icon: Icons.logout;
                                danger: true;
                                pill-height: 34px;
                                clicked => { Actions.lastfm-disconnect(); }
                            }
                        }
                        if Player.lastfm.state == "connecting": SettingRow {
                            label: "Waiting for approval…";
                            hint: "A Last.fm page opened in your browser. Approve Lychee there and this will finish automatically.";
                            PillButton {
                                text: "Cancel";
                                has-icon: false;
                                pill-height: 34px;
                                clicked => { Actions.lastfm-cancel(); }
                            }
                        }
                        if Player.lastfm.state == "disconnected": SettingRow {
                            label: "Not connected";
                            hint: Player.lastfm.builtin-key || (Player.lastfm.api-key != "" && Player.lastfm.api-secret != "")
                                ? "You'll approve Lychee in your browser; no password is stored."
                                : "This build has no Last.fm API key. Add your own below to connect.";
                            PillButton {
                                text: "Connect";
                                icon: Icons.link;
                                primary: true;
                                pill-height: 34px;
                                enabled: Player.lastfm.builtin-key || (Player.lastfm.api-key != "" && Player.lastfm.api-secret != "");
                                clicked => { Actions.lastfm-connect(); }
                            }
                        }
                        if Player.lastfm.message != "" && Player.lastfm.state == "disconnected": Text {
                            text: Player.lastfm.message;
                            color: Theme.danger;
                            wrap: word-wrap;
                        }
                        Divider { }
                        SettingRow {
                            label: "Artist to scrobble";
                            hint: Player.lastfm.artist-mode == 0
                                ? "Featured artists are left out, so \"A feat. B\", \"A; B\" and songs tagged with artists A and B scrobble as A. Titles are sent as tagged."
                                : "The artist tag is sent exactly as written.";
                            Segmented {
                                options: ["Main artist", "Exact tags"];
                                selected: Player.lastfm.artist-mode;
                                changed(i) => { Actions.lastfm-set-artist-mode(i); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            label: "Love tracks on Last.fm";
                            hint: "Adding a song to Favorites also loves it on Last.fm.";
                            Toggle {
                                checked: Player.lastfm.love-sync;
                                toggled(on) => { Actions.lastfm-set-love-sync(on); }
                            }
                        }
                        if !Player.lastfm.builtin-key: VerticalLayout {
                            spacing: 8px;
                            Divider { }
                            Text {
                                text: "API account";
                                font-weight: 500;
                                color: Theme.text;
                            }
                            Text {
                                text: "Create one at last.fm/api/account/create (any name and callback work), then paste the key and shared secret.";
                                font-size: 12.5px;
                                color: Theme.text-3;
                                wrap: word-wrap;
                            }
                            key-field := TextField {
                                has-icon: false;
                                placeholder: "API key";
                                text: Player.lastfm.api-key;
                            }
                            secret-field := TextField {
                                has-icon: false;
                                password: true;
                                placeholder: "Shared secret";
                                text: Player.lastfm.api-secret;
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                spacing: 10px;
                                alignment: start;
                                PillButton {
                                    text: "Save";
                                    has-icon: false;
                                    pill-height: 34px;
                                    clicked => { Actions.lastfm-set-keys(key-field.text, secret-field.text); }
                                }
                                PillButton {
                                    text: "Open last.fm/api";
                                    icon: Icons.external;
                                    pill-height: 34px;
                                    clicked => { Actions.open-url("https://www.last.fm/api/account/create"); }
                                }
                            }
                        }
                    }

                    Section {
                        title: "Appearance";
                        SettingRow {
                            label: "Mode";
                            hint: "System follows your desktop's light or dark setting.";
                            Segmented {
                                options: ["System", "Dark", "Light"];
                                selected <=> AppState.theme-mode;
                                changed(i) => { Actions.set-theme-mode(i); }
                            }
                        }
                        SettingRow {
                            label: "Dark theme";
                            hint: Theme.dark ? "" : AppState.theme-mode == 0 ? "Used when your system is dark." : "Used in dark mode.";
                            ThemeSelect {
                                themes: AppState.dark-themes;
                                current: AppState.dark-theme;
                            }
                        }
                        SettingRow {
                            label: "Light theme";
                            hint: !Theme.dark ? "" : AppState.theme-mode == 0 ? "Used when your system is light." : "Used in light mode.";
                            ThemeSelect {
                                themes: AppState.light-themes;
                                current: AppState.light-theme;
                            }
                        }
                        Divider { }
                        SettingRow {
                            label: "Colours from album art";
                            hint: "Tint the interface with the colours of what's playing or open.";
                            Toggle {
                                checked: AppState.dynamic-accent;
                                toggled(on) => { Actions.set-dynamic-accent(on); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            label: "Keep the mini player on top";
                            hint: AppState.wayland
                                ? "Wayland doesn't let apps stay above other windows, so Lychee runs the mini player through XWayland. Turn this off for a native (but not on-top) window."
                                : "The mini player stays above other windows.";
                            Toggle {
                                checked: AppState.mini-on-top;
                                toggled(on) => { Actions.set-mini-on-top(on); }
                            }
                        }
                    }

                    Section {
                        title: "Keyboard shortcuts";
                        ShortcutRow { action: "Play / pause"; keys: "Space"; }
                        ShortcutRow { action: "Previous / next track"; keys: AppState.mac ? "⌘← / ⌘→" : "Ctrl ← / Ctrl →"; }
                        ShortcutRow { action: "Seek back / forward 10 seconds"; keys: "← / →"; }
                        ShortcutRow { action: "Volume down / up"; keys: AppState.mac ? "⌘↓ / ⌘↑" : "Ctrl ↓ / Ctrl ↑"; }
                        ShortcutRow { action: "Search and commands"; keys: AppState.mac ? "⌘K" : "Ctrl K"; }
                        ShortcutRow { action: "Mini player"; keys: AppState.mac ? "⌘M" : "Ctrl M"; }
                        ShortcutRow { action: "Toggle the queue panel"; keys: AppState.mac ? "⌃⌘S" : "Ctrl Q"; }
                        ShortcutRow { action: "Settings"; keys: AppState.mac ? "⌘," : "Ctrl ,"; }
                        ShortcutRow { action: "Back / close"; keys: "Esc"; }
                        ShortcutRow { action: "Tag editor: save / undo / redo"; keys: AppState.mac ? "⌘S / ⌘Z / ⇧⌘Z" : "Ctrl S / Ctrl Z / Ctrl Shift Z"; }
                        ShortcutRow { action: "Tag editor: select all files"; keys: AppState.mac ? "⌘A" : "Ctrl A"; }
                    }

                    Section {
                        title: "About";
                        description: "Lychee is free software licensed under the Apache License 2.0. Fonts: Geist and Geist Mono (SIL Open Font License 1.1). Decoding by Symphonia, tags by Lofty. Online lookups use MusicBrainz, the Cover Art Archive and LRCLIB. The Catppuccin, Tokyo Night, Gruvbox and Rosé Pine themes are adapted from those projects' open-source palettes.";
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            spacing: 10px;
                            alignment: start;
                            PillButton {
                                text: "Source code";
                                icon: Icons.external;
                                pill-height: 34px;
                                clicked => { Actions.open-url("https://github.com/Noffee25/Lychee"); }
                            }
                        }
                        AboutSlint {
                            height: 150px;
                        }
                    }
                }
            }
        }
    }
}
