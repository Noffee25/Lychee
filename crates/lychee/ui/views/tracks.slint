import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppState, Actions, Player, TrackRow } from "../state.slint";
import { Cover, PlayingBars, IconButton, PillButton, Segmented, Divider, DragTouch, DropLine } from "../widgets.slint";
import { Grid } from "albums.slint";
import { ListView, LineEdit } from "std-widgets.slint";

export component TrackHeader inherits Rectangle {
    in property <bool> show-cover;
    in property <bool> show-album;
    height: 34px;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text { width: 28px; text: "#"; horizontal-alignment: center; vertical-alignment: center; color: Theme.text-3; font-size: 12px; }
        if root.show-cover: Rectangle { width: 36px; }
        Text { horizontal-stretch: 2; preferred-width: 0px; min-width: 0px; text: "Title"; vertical-alignment: center; color: Theme.text-3; font-size: 12px; }
        if root.show-album: Text { horizontal-stretch: 1.2; preferred-width: 0px; min-width: 0px; text: "Album"; vertical-alignment: center; color: Theme.text-3; font-size: 12px; }
        Text { width: 56px; text: "Plays"; horizontal-alignment: right; vertical-alignment: center; color: Theme.text-3; font-size: 12px; }
        Rectangle { width: 28px; }
        Rectangle {
            width: 50px;
            Image {
                x: parent.width - 14px;
                source: Icons.clock;
                colorize: Theme.text-3;
                width: 14px;
                height: 14px;
            }
        }
    }
    Divider {
        y: parent.height - 1px;
        width: 100%;
    }
}

export component TrackRowView inherits Rectangle {
    in property <TrackRow> track;
    in property <string> context;
    in property <bool> show-cover;
    in property <bool> show-album;
    in property <bool> in-playlist;
    // This row is being dragged (playlist pages), or a dragged row would land next to it.
    property <bool> dragged: AppState.drag-kind == "playlist" && AppState.drag-from == root.track.index;
    property <bool> drop-target: AppState.drag-kind == "playlist" && AppState.drag-from >= 0
        && AppState.drag-to == root.track.index && AppState.drag-to != AppState.drag-from;
    property <bool> hovered: row-ta.has-hover || like-ta.has-hover;
    height: 48px;
    border-radius: 9px;
    background: root.dragged ? Theme.accent.with-alpha(0.14)
        : root.track.current ? Theme.accent.with-alpha(0.10) : root.hovered ? Theme.hover : transparent;
    // Click to play; on a playlist page, press anywhere on the row and drag to move the song.
    row-ta := DragTouch {
        draggable: root.in-playlist;
        tapped => { Actions.play-from(root.context, root.track.index); }
        dragged(dy) => {
            AppState.drag-kind = "playlist";
            AppState.drag-from = root.track.index;
            AppState.drag-to = Math.clamp(root.track.index + Math.round(dy / root.height), 0, AppState.tracks.length - 1);
        }
        released(drop) => {
            if (drop && AppState.drag-kind == "playlist" && AppState.drag-from >= 0 && AppState.drag-to != AppState.drag-from) {
                Actions.playlist-move(AppState.drag-from, AppState.drag-to);
            }
            AppState.drag-from = -1;
            AppState.drag-to = -1;
        }
    }
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Rectangle {
            width: 28px;
            if root.track.current && !root.hovered: PlayingBars { moving: Player.playing; }
            if root.hovered: Image {
                source: Icons.play;
                colorize: Theme.text;
                width: 14px;
                height: 14px;
            }
            if !root.track.current && !root.hovered: Text {
                text: root.track.number;
                font-family: Theme.mono;
                font-size: 12.5px;
                color: Theme.text-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.show-cover: Cover {
            width: 36px;
            height: 36px;
            radius: 6px;
            source: root.track.cover;
            has-image: root.track.has-cover;
        }
        VerticalLayout {
            horizontal-stretch: 2;
            preferred-width: 0px;
            min-width: 0px;
            alignment: center;
            Text {
                text: root.track.title;
                font-weight: 500;
                font-size: 14px;
                color: root.track.current ? Theme.accent : Theme.text;
                overflow: elide;
            }
            if root.track.artist != "": Text {
                text: root.track.artist;
                font-size: 12.5px;
                color: Theme.text-3;
                overflow: elide;
            }
        }
        if root.show-album: Text {
            horizontal-stretch: 1.2;
            preferred-width: 0px;
            min-width: 0px;
            text: root.track.album;
            color: Theme.text-2;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 56px;
            text: root.track.plays;
            font-family: Theme.mono;
            font-size: 12.5px;
            color: Theme.text-3;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: 28px;
            Image {
                source: root.track.liked ? Icons.heart-fill : Icons.heart;
                colorize: root.track.liked ? Theme.accent : like-ta.has-hover ? Theme.text : Theme.text-3;
                width: 15px;
                height: 15px;
                opacity: root.track.liked || root.hovered ? 1 : 0;
            }
            like-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Actions.track-action("like", root.track.id); }
            }
        }
        Text {
            width: 50px;
            text: root.track.duration;
            font-family: Theme.mono;
            font-size: 12.5px;
            color: Theme.text-2;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if root.drop-target: DropLine {
        x: 8px;
        width: parent.width - 16px;
        y: AppState.drag-to > AppState.drag-from ? parent.height - 1px : -1px;
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Play";
                activated => { Actions.play-from(root.context, root.track.index); }
            }
            MenuItem {
                title: "Play next";
                activated => { Actions.track-action("play-next", root.track.id); }
            }
            MenuItem {
                title: "Add to queue";
                activated => { Actions.track-action("add-queue", root.track.id); }
            }
            Menu {
                title: "Add to playlist";
                MenuItem {
                    title: "New playlist";
                    activated => { Actions.add-to-playlist(-1, "track", root.track.id); }
                }
                MenuSeparator { }
                for playlist in AppState.playlists: MenuItem {
                    title: playlist.name;
                    activated => { Actions.add-to-playlist(playlist.id, "track", root.track.id); }
                }
            }
            MenuItem {
                title: root.track.liked ? "Remove from Favorites" : "Add to Favorites";
                activated => { Actions.track-action("like", root.track.id); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Go to album";
                activated => { Actions.track-action("go-album", root.track.id); }
            }
            MenuItem {
                title: "Go to artist";
                activated => { Actions.track-action("go-artist", root.track.id); }
            }
            MenuItem {
                title: "Show in folder";
                activated => { Actions.track-action("show-folder", root.track.id); }
            }
            MenuItem {
                title: "Edit tags…";
                activated => { Actions.track-action("edit-tags", root.track.id); }
            }
            if root.in-playlist: MenuSeparator { }
            if root.in-playlist: Menu {
                title: "Move";
                MenuItem {
                    title: "To the top";
                    enabled: root.track.index > 0;
                    activated => { Actions.playlist-move(root.track.index, 0); }
                }
                MenuItem {
                    title: "Up";
                    enabled: root.track.index > 0;
                    activated => { Actions.playlist-move(root.track.index, root.track.index - 1); }
                }
                MenuItem {
                    title: "Down";
                    enabled: root.track.index < AppState.tracks.length - 1;
                    activated => { Actions.playlist-move(root.track.index, root.track.index + 1); }
                }
                MenuItem {
                    title: "To the bottom";
                    enabled: root.track.index < AppState.tracks.length - 1;
                    activated => { Actions.playlist-move(root.track.index, AppState.tracks.length - 1); }
                }
            }
            if root.in-playlist: MenuItem {
                title: "Remove from this playlist";
                activated => { Actions.track-action("remove-from-playlist", root.track.index); }
            }
        }
    }
}

// The "⋯" button on a playlist page: queueing, copying and one-off sorting.
component PlaylistMore inherits Rectangle {
    width: 40px;
    height: 40px;
    property <int> id: AppState.list-header.id;
    property <bool> has-songs: AppState.tracks.length > 0;
    more-menu := ContextMenuArea {
        IconButton {
            icon: Icons.more;
            size: 40px;
            tooltip: "More";
            clicked => { more-menu.show({ x: 0px, y: self.height + 4px }); }
        }
        Menu {
            MenuItem {
                title: "Play next";
                enabled: root.has-songs;
                activated => { Actions.playlist-command("play-next", root.id); }
            }
            MenuItem {
                title: "Add to queue";
                enabled: root.has-songs;
                activated => { Actions.playlist-command("add-queue", root.id); }
            }
            MenuSeparator { }
            Menu {
                title: "Sort by";
                enabled: AppState.tracks.length > 1;
                MenuItem {
                    title: "Title";
                    activated => { Actions.playlist-command("sort-title", root.id); }
                }
                MenuItem {
                    title: "Artist";
                    activated => { Actions.playlist-command("sort-artist", root.id); }
                }
                MenuItem {
                    title: "Album";
                    activated => { Actions.playlist-command("sort-album", root.id); }
                }
                MenuItem {
                    title: "Length";
                    activated => { Actions.playlist-command("sort-duration", root.id); }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Reverse the order";
                    activated => { Actions.playlist-command("reverse", root.id); }
                }
            }
            MenuItem {
                title: AppState.list-header.duplicates > 0
                    ? "Remove duplicates (" + AppState.list-header.duplicates + ")" : "Remove duplicates";
                enabled: AppState.list-header.duplicates > 0;
                activated => { Actions.playlist-command("dedupe", root.id); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Duplicate playlist";
                activated => { Actions.playlist-command("duplicate", root.id); }
            }
        }
    }
}

// Header block for list pages: Favorites, playlists, songs, history.
component ListHero inherits HorizontalLayout {
    padding-left: Grid.side-padding;
    padding-right: Grid.side-padding;
    padding-bottom: 16px;
    spacing: 22px;
    if AppState.page == "favorites": Rectangle {
        width: 132px;
        height: 132px;
        border-radius: 12px;
        background: @linear-gradient(135deg, Theme.accent 0%, #8B5CF6 100%);
        drop-shadow-blur: 22px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: Theme.shadow;
        Image {
            source: Icons.heart-fill;
            colorize: #ffffff;
            width: 44px;
            height: 44px;
        }
    }
    if AppState.page == "playlist": Cover {
        width: 132px;
        height: 132px;
        radius: 12px;
        source: AppState.list-header.cover;
        has-image: AppState.list-header.has-cover;
        tiles: AppState.list-header.covers;
        seed: AppState.list-header.seed;
        drop-shadow-blur: 22px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: Theme.shadow;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: end;
        spacing: 6px;
        Text {
            text: AppState.list-header.kind;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-2;
        }
        if !AppState.renaming-playlist: Text {
            text: AppState.list-header.title;
            font-size: AppState.page == "favorites" || AppState.page == "playlist" ? 40px : 30px;
            font-weight: 750;
            letter-spacing: -1px;
            color: Theme.text;
            overflow: elide;
        }
        if AppState.renaming-playlist: LineEdit {
            text: AppState.list-header.title;
            font-size: 20px;
            init => {
                self.focus();
                self.select-all();
            }
            accepted(name) => {
                if (name != "") {
                    Actions.rename-playlist(AppState.list-header.id, name);
                }
                AppState.renaming-playlist = false;
            }
        }
        Text {
            text: AppState.list-header.subtitle;
            color: Theme.text-2;
            overflow: elide;
        }
        HorizontalLayout {
            cross-axis-alignment: center;
            padding-top: 8px;
            spacing: 10px;
            alignment: start;
            PillButton {
                text: "Play";
                icon: Icons.play;
                primary: true;
                enabled: AppState.tracks.length > 0;
                clicked => { Actions.play-list(false); }
            }
            PillButton {
                text: "Shuffle";
                icon: Icons.shuffle;
                enabled: AppState.tracks.length > 0;
                clicked => { Actions.play-list(true); }
            }
            if AppState.list-header.editable: IconButton {
                icon: Icons.edit;
                size: 40px;
                tooltip: "Rename playlist";
                clicked => { AppState.renaming-playlist = !AppState.renaming-playlist; }
            }
            if AppState.list-header.editable: IconButton {
                icon: Icons.trash;
                size: 40px;
                tooltip: "Delete playlist";
                clicked => { Actions.playlist-command("delete", AppState.list-header.id); }
            }
            if AppState.list-header.editable: PlaylistMore { }
            Rectangle { horizontal-stretch: 1; }
            if AppState.page == "songs": VerticalLayout {
                alignment: center;
                Segmented {
                    options: ["Artist", "Title", "Album", "Most played", "Added"];
                    selected: AppState.track-sort;
                    changed(i) => { Actions.set-track-sort(i); }
                }
            }
        }
    }
}

export component ListPage inherits Rectangle {
    VerticalLayout {
        padding-top: 52px;
        ListHero { }
        Rectangle {
            vertical-stretch: 1;
            if AppState.tracks.length == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: AppState.page == "favorites" ? "No favorites yet" : AppState.page == "history" ? "Nothing played yet" : "This list is empty";
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: AppState.page == "favorites" ? "Tap the heart next to any song to keep it here."
                        : AppState.page == "playlist" ? "Right-click a song or album and choose \"Add to playlist\"."
                        : "Songs you listen to will show up here.";
                    color: Theme.text-3;
                    horizontal-alignment: center;
                }
            }
            if AppState.tracks.length > 0: VerticalLayout {
                padding-left: Grid.side-padding - 12px;
                padding-right: Grid.side-padding - 12px;
                TrackHeader {
                    show-cover: true;
                    show-album: AppState.tracks-show-album;
                }
                Rectangle { height: 6px; }
                ListView {
                    vertical-stretch: 1;
                    for row in AppState.tracks: TrackRowView {
                        track: row;
                        context: "list";
                        show-cover: true;
                        show-album: AppState.tracks-show-album;
                        in-playlist: AppState.page == "playlist";
                    }
                }
            }
        }
    }
}
