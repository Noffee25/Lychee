import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppState, Actions, NavPlaylist } from "../state.slint";
import { NavItem, IconButton, Divider, TextField, DropLine } from "../widgets.slint";
import { Editor } from "../editor-state.slint";
import { ScrollView } from "std-widgets.slint";

component GroupLabel inherits Rectangle {
    in property <string> text;
    in property <bool> has-add;
    callback add;
    height: 30px;
    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 10px;
        padding-right: 2px;
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 500;
            color: Theme.text-3;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.has-add: IconButton {
            icon: Icons.plus;
            size: 24px;
            icon-size: 14px;
            tooltip: "New playlist";
            clicked => { root.add(); }
        }
    }
}

// A playlist in the sidebar: opens on click, drags to a new place, and has a right-click menu.
component PlaylistNav inherits Rectangle {
    in property <NavPlaylist> playlist;
    in property <int> position;
    // Rows are 32 px tall with 2 px between them.
    property <length> pitch: 34px;
    property <bool> dragged: AppState.drag-kind == "nav" && AppState.drag-from == root.position;
    property <bool> drop-target: AppState.drag-kind == "nav" && AppState.drag-from >= 0
        && AppState.drag-to == root.position && AppState.drag-to != AppState.drag-from;
    height: 32px;
    border-radius: 8px;
    background: root.dragged ? Theme.accent.with-alpha(0.14) : transparent;
    NavItem {
        width: 100%;
        height: 100%;
        label: root.playlist.name;
        use-cover: true;
        cover: root.playlist.cover;
        has-cover: root.playlist.has-cover;
        tiles: root.playlist.covers;
        seed: root.playlist.seed;
        count: root.playlist.count;
        active: AppState.page == "playlist" && AppState.list-header.id == root.playlist.id;
        draggable: true;
        clicked => { Actions.open-playlist(root.playlist.id); }
        drag-moved(dy) => {
            AppState.drag-kind = "nav";
            AppState.drag-from = root.position;
            AppState.drag-to = Math.clamp(root.position + Math.round(dy / root.pitch), 0, AppState.playlists.length - 1);
        }
        drag-released(drop) => {
            if (drop && AppState.drag-kind == "nav" && AppState.drag-from >= 0 && AppState.drag-to != AppState.drag-from) {
                Actions.nav-playlist-move(root.playlist.id, AppState.drag-to);
            }
            AppState.drag-from = -1;
            AppState.drag-to = -1;
        }
    }
    if root.drop-target: DropLine {
        x: 8px;
        width: parent.width - 16px;
        y: AppState.drag-to > AppState.drag-from ? parent.height - 1px : -1px;
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Play";
                enabled: root.playlist.count > 0;
                activated => { Actions.playlist-command("play", root.playlist.id); }
            }
            MenuItem {
                title: "Shuffle";
                enabled: root.playlist.count > 0;
                activated => { Actions.playlist-command("shuffle", root.playlist.id); }
            }
            MenuItem {
                title: "Play next";
                enabled: root.playlist.count > 0;
                activated => { Actions.playlist-command("play-next", root.playlist.id); }
            }
            MenuItem {
                title: "Add to queue";
                enabled: root.playlist.count > 0;
                activated => { Actions.playlist-command("add-queue", root.playlist.id); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Rename";
                activated => { Actions.playlist-command("rename", root.playlist.id); }
            }
            MenuItem {
                title: "Duplicate";
                activated => { Actions.playlist-command("duplicate", root.playlist.id); }
            }
            MenuItem {
                title: "Delete";
                activated => { Actions.playlist-command("delete", root.playlist.id); }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    property <bool> creating;
    width: 236px;
    background: Theme.side;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        padding: 12px;
        padding-top: 14px;
        spacing: 2px;
        HorizontalLayout {
            cross-axis-alignment: center;
            height: 36px;
            padding-left: 6px;
            spacing: 9px;
            Image {
                source: Icons.logo;
                width: 24px;
                height: 24px;
            }
            Text {
                text: "Lychee";
                font-size: 15.5px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Rectangle { height: 6px; }
        Rectangle {
            height: 34px;
            border-radius: 9px;
            border-width: 1px;
            border-color: search-ta.has-hover ? Theme.text-3 : Theme.border-2;
            background: Theme.surface;
            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 10px;
                padding-right: 7px;
                spacing: 8px;
                Image {
                    source: Icons.search;
                    colorize: Theme.text-3;
                    width: 15px;
                    height: 15px;
                }
                Text {
                    text: "Search";
                    color: Theme.text-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    height: 20px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.border-2;
                    background: Theme.surface-2;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: AppState.mac ? "⌘K" : "Ctrl K";
                            font-family: Theme.mono;
                            font-size: 11px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            search-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Actions.open-palette(); }
            }
        }
        Rectangle { height: 10px; }
        NavItem {
            label: "Recently Added";
            icon: Icons.clock;
            active: AppState.page == "recent";
            clicked => { Actions.navigate("recent"); }
        }
        NavItem {
            label: "Recently Played";
            icon: Icons.history;
            active: AppState.page == "history";
            clicked => { Actions.navigate("history"); }
        }
        GroupLabel { text: "Library"; }
        NavItem {
            label: "Albums";
            icon: Icons.disc;
            count: AppState.count-albums;
            active: AppState.page == "albums" || AppState.page == "album";
            clicked => { Actions.navigate("albums"); }
        }
        NavItem {
            label: "Artists";
            icon: Icons.user;
            count: AppState.count-artists;
            active: AppState.page == "artists" || AppState.page == "artist";
            clicked => { Actions.navigate("artists"); }
        }
        NavItem {
            label: "Songs";
            icon: Icons.music;
            count: AppState.count-songs;
            active: AppState.page == "songs";
            clicked => { Actions.navigate("songs"); }
        }
        NavItem {
            label: "Genres";
            icon: Icons.tag;
            active: AppState.page == "genres" || AppState.page == "genre";
            clicked => { Actions.navigate("genres"); }
        }
        NavItem {
            label: "Tag Editor";
            icon: Icons.edit;
            count: Editor.modified-count > 0 ? Editor.modified-count + " unsaved" : "";
            active: AppState.page == "editor";
            clicked => { Actions.navigate("editor"); }
        }
        GroupLabel {
            text: "Playlists";
            has-add: true;
            add => { root.creating = true; }
        }
        NavItem {
            label: "Favorites";
            liked-tile: true;
            count: AppState.favorites-count > 0 ? AppState.favorites-count : "";
            active: AppState.page == "favorites";
            clicked => { Actions.navigate("favorites"); }
        }
        if root.creating: Rectangle {
            height: 40px;
            TextField {
                init => { self.focus(); }
                y: 3px;
                height: 32px;
                has-icon: false;
                placeholder: "Playlist name, then Enter";
                accepted(name) => {
                    if (name != "") {
                        Actions.create-playlist(name);
                    }
                    self.text = "";
                    root.creating = false;
                }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            // No minimum: at the smallest window height a 60 px minimum pushed the player bar
            // partly out of the window. It still gets whatever height is left, and scrolls.
            min-height: 0px;
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                for playlist[i] in AppState.playlists: PlaylistNav {
                    playlist: playlist;
                    position: i;
                }
            }
        }
        Divider {}
        Rectangle { height: 6px; }
        NavItem {
            label: "Settings";
            icon: Icons.settings;
            active: AppState.page == "settings";
            clicked => { Actions.navigate("settings"); }
        }
    }
}
