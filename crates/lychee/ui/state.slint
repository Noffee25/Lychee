// Data shown by the UI and the callbacks it sends back to Rust.
// Rust fills these globals; views only read them and call `Actions`.

import { ThemeColors } from "theme.slint";

export struct AlbumCard {
    id: int,
    title: string,
    artist: string,
    year: string,
    cover: image,
    has-cover: bool,
    hires: bool,
    playing: bool,
    seed: color,
}

export struct AlbumRow {
    items: [AlbumCard],
}

export struct TrackRow {
    id: int,
    index: int,
    number: string,
    title: string,
    artist: string,
    album: string,
    album-id: int,
    year: string,
    duration: string,
    plays: string,
    liked: bool,
    current: bool,
    cover: image,
    has-cover: bool,
    disc-header: string,
}

export struct QueueItem {
    index: int,
    title: string,
    artist: string,
    duration: string,
    cover: image,
    has-cover: bool,
}

export struct ArtistCard {
    name: string,
    detail: string,
    cover: image,
    has-cover: bool,
    seed: color,
}

export struct GenreCard {
    name: string,
    detail: string,
    cover: image,
    has-cover: bool,
    seed: color,
}

export struct GenreRow {
    items: [GenreCard],
}

export struct NavPlaylist {
    id: int,
    name: string,
    count: int,
    cover: image,
    has-cover: bool,
    // Covers of the first four albums, for a 2×2 mosaic (fewer than four: `cover` alone).
    covers: [image],
    seed: color,
}

export struct PaletteItem {
    section: string,
    kind: string,
    title: string,
    subtitle: string,
    hint: string,
    cover: image,
    has-cover: bool,
    icon: image,
    seed: color,
}

export struct Lyric {
    text: string,
    time-ms: int,
}

export struct InfoRow {
    label: string,
    value: string,
}

export struct Choice {
    label: string,
    selected: bool,
}

export struct AlbumHeader {
    id: int,
    title: string,
    artist: string,
    meta: string,
    cover: image,
    has-cover: bool,
    seed: color,
    tags: [string],
    hires: bool,
    note: string,
}

export struct ListHeader {
    kind: string,
    title: string,
    subtitle: string,
    cover: image,
    has-cover: bool,
    seed: color,
    // As in NavPlaylist: a playlist's mosaic.
    covers: [image],
    id: int,
    editable: bool,
    // Songs that appear more than once (playlists), for "Remove duplicates".
    duplicates: int,
}

export struct NowPlaying {
    has-track: bool,
    id: int,
    title: string,
    artist: string,
    // The credit split into separate artists, each a link ("A feat. B, C" → A, B, C).
    artists: [string],
    album: string,
    album-id: int,
    cover: image,
    has-cover: bool,
    seed: color,
    format: string,
    quality: string,
    liked: bool,
}

export struct LastfmUi {
    // "disconnected", "connecting", "idle", "submitting", "offline", "error"
    state: string,
    username: string,
    pending: int,
    scrobbled: int,
    last: string,
    message: string,
    love-sync: bool,
    // 0 = main artist, 1 = exact tags
    artist-mode: int,
    builtin-key: bool,
    api-key: string,
    api-secret: string,
}

export struct ScanUi {
    active: bool,
    text: string,
    progress: float,
}

// A theme in the Settings picker.
export struct ThemeCard {
    id: string,
    name: string,
    blurb: string,
    colors: ThemeColors,
    accent: color,
    selected: bool,
}

export global AppState {
    // macOS: Slint maps Control to ⌘ there, so labels say ⌘ instead of Ctrl, and ⌘Q is Quit, so the
    // side panel toggles with ⌃⌘S instead of Ctrl Q.
    out property <bool> mac: Platform.os == OperatingSystemType.macos;
    // Navigation: "albums", "album", "artists", "artist", "songs", "genres", "genre",
    // "recent", "favorites", "playlist", "history", "settings".
    in-out property <string> page: "albums";
    in-out property <bool> can-go-back;
    in-out property <bool> can-go-forward;
    in-out property <bool> right-panel: true;
    in-out property <string> right-tab: "queue";
    // The side panel sits beside the content only when the window is wide enough; the window sets
    // panel-docked. In narrower windows it opens over the content as a drawer, which starts closed
    // and isn't saved. right-panel stays the (saved) choice for the docked panel.
    in-out property <bool> panel-docked: true;
    in-out property <bool> panel-drawer;
    out property <bool> panel-shown: panel-docked ? right-panel : panel-drawer;
    public function set-panel(shown: bool) {
        if (panel-docked) {
            right-panel = shown;
        } else {
            panel-drawer = shown;
        }
    }
    public function toggle-panel() {
        set-panel(!panel-shown);
    }
    // The Lyrics and Queue buttons: open the panel on that tab, or close it if it already shows it.
    public function toggle-tab(tab: string) {
        if (panel-shown && right-tab == tab) {
            set-panel(false);
        } else {
            right-tab = tab;
            set-panel(true);
        }
    }
    in-out property <bool> palette-open;
    in-out property <bool> library-empty;

    in-out property <[AlbumRow]> album-rows;
    in-out property <string> albums-title: "Albums";
    in-out property <string> albums-subtitle;
    in-out property <int> album-sort;
    in-out property <bool> albums-sortable: true;

    in-out property <AlbumHeader> album;
    in-out property <[TrackRow]> album-tracks;
    in-out property <[AlbumRow]> more-albums;
    in-out property <string> more-title;

    in-out property <ListHeader> list-header;
    in-out property <[TrackRow]> tracks;
    in-out property <int> track-sort;
    in-out property <bool> tracks-show-album: true;

    in-out property <[ArtistCard]> artists;
    in-out property <[AlbumRow]> artist-album-rows;
    in-out property <[GenreRow]> genre-rows;
    in-out property <string> count-albums;
    in-out property <string> count-artists;
    in-out property <string> count-songs;
    in-out property <bool> content-scrolled;
    in-out property <[NavPlaylist]> playlists;
    in-out property <int> favorites-count;

    in-out property <[QueueItem]> queue-manual;
    in-out property <[QueueItem]> queue-context;
    in-out property <string> queue-context-name;

    in-out property <[Lyric]> lyrics;
    in-out property <bool> lyrics-synced;
    in-out property <string> lyrics-source;
    in-out property <int> lyric-index: -1;
    in-out property <[InfoRow]> details;

    in-out property <string> palette-query;
    in-out property <[PaletteItem]> palette-items;
    in-out property <int> palette-selected;

    in-out property <ScanUi> scan;
    in-out property <string> library-summary;
    in-out property <[string]> folders;
    in-out property <[Choice]> devices;
    in-out property <string> device-name;
    // The output device chosen in Settings; device-name is the one the engine actually opened.
    in-out property <string> device-choice;
    in-out property <int> theme-mode;
    // The themes in Settings; `selected` marks the dark and the light theme in use.
    in-out property <[ThemeCard]> dark-themes;
    in-out property <[ThemeCard]> light-themes;
    in-out property <ThemeCard> dark-theme;
    in-out property <ThemeCard> light-theme;
    in-out property <bool> dynamic-accent: true;
    in-out property <bool> mini-on-top: true;
    in-out property <bool> volume-levelling: true;
    // Pre-amp choice: 0 = 0 dB, 1 = +2, 2 = +4, 3 = +6.
    in-out property <int> levelling-preamp;
    // What volume levelling knows: "Measuring loudness… 40 of 120" or how many songs it covers.
    in-out property <string> levelling-status;
    in-out property <bool> wayland;
    in-out property <string> toast;
    // A button in the toast ("Undo", "Open"); Actions.toast-action runs it. Ctrl+Z runs "Undo".
    in-out property <string> toast-action;
    // Dragging a row to reorder it: "playlist" (songs on a playlist page), "queue" or "nav"
    // (sidebar playlists). `drag-to` is where it would land; both are -1 when nothing is dragged.
    in-out property <string> drag-kind;
    in-out property <int> drag-from: -1;
    in-out property <int> drag-to: -1;
    // The playlist page shows its name as a text field (Rename from a menu).
    in-out property <bool> renaming-playlist;
    in-out property <string> version;
}

export global Player {
    in-out property <NowPlaying> now;
    in-out property <bool> playing;
    in-out property <float> progress;
    in-out property <int> duration-ms;
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <float> volume: 0.8;
    in-out property <bool> muted;
    in-out property <bool> shuffle;
    // 0 = off, 1 = all, 2 = one
    in-out property <int> repeat;
    in-out property <LastfmUi> lastfm;
}

export global Actions {
    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback open-album(int);
    callback open-artist(string);
    callback open-genre(string);
    callback open-playlist(int);

    callback play-album(int, bool);
    callback album-action(string, int);
    // Play the visible track list ("album" page or the current "list") starting at an index.
    callback play-from(string, int);
    callback play-list(bool);
    callback track-action(string, int);
    callback add-to-playlist(int, string, int);

    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-by(int);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-like-current();

    callback queue-jump(int);
    callback queue-remove(int);
    callback queue-move(int, int);
    callback save-queue();
    callback toast-action();
    // Move a song on the open playlist from one row to another.
    callback playlist-move(int, int);
    // "play", "shuffle", "play-next", "add-queue", "rename", "duplicate", "delete", "sort-title",
    // "sort-artist", "sort-album", "sort-duration", "reverse", "dedupe" on playlist `id`.
    callback playlist-command(string, int);
    // Move sidebar playlist `id` to row `to`.
    callback nav-playlist-move(int, int);
    callback queue-clear();
    callback lyric-seek(int);

    callback set-grid-columns(int);
    callback set-album-sort(int);
    callback set-track-sort(int);

    callback open-palette();
    callback palette-query-changed(string);
    callback palette-activate(int, bool);

    callback add-folder();
    callback remove-folder(string);
    callback rescan();
    callback set-device(string);
    callback set-theme-mode(int);
    callback set-theme(string);
    callback set-dynamic-accent(bool);
    callback set-mini-on-top(bool);
    callback set-volume-levelling(bool);
    callback set-levelling-preamp(int);

    callback lastfm-connect();
    callback lastfm-cancel();
    callback lastfm-disconnect();
    callback lastfm-retry();
    callback lastfm-set-keys(string, string);
    callback lastfm-set-love-sync(bool);
    callback lastfm-set-artist-mode(int);
    callback lastfm-open-profile();

    callback create-playlist(string);
    callback rename-playlist(int, string);

    callback open-mini();
    callback close-mini();
    callback start-window-drag();
    callback open-url(string);
}
